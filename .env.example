# Firebase credentials
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_PUBLIC_KEY=

# Backend API Origin:
# - Leave empty for local development & Dev Tunnel (same-origin /api/* via Vite proxy)
# - Set only for split-origin deployment (e.g. https://api.example.com)
VITE_API_BASE_URL=

# Optional: WebSocket Base URL (leave unset for automatic derivation from page origin / VITE_API_BASE_URL)
# VITE_WS_BASE_URL=wss://api.example.com
